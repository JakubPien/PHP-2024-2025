kw3:

SELECT rok, AVG(dlugosc) AS "Średnia długość" FROM parada JOIN udzial ON parada.id = udzial.id_parada JOIN smok ON smok.id = udzial.id_smok WHERE rok > 2005 GROUP BY rok;

